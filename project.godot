; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FrogPop: Bubble Quest"
config/name_localized={
"tr": "FrogPop: Balon Macerası"
}
config/description="Offline endless bubble-chain shooter with an animated frog mascot."
config/version="1.0.0"
run/main_scene="res://scenes/boot/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.04, 0.23, 0.27, 1)
boot_splash/image="res://assets/branding/splash.png"
config/icon="res://assets/branding/icon.png"

[autoload]

SaveManager="*res://scripts/save/save_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
LocalizationManager="*res://scripts/core/localization_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
ThemeManager="*res://scripts/world/theme_manager.gd"
ProgressionManager="*res://scripts/progression/progression_manager.gd"
AdsManager="*res://scripts/ads/ads_manager.gd"
PurchaseManager="*res://scripts/purchases/purchase_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.05, 0.1, 0.09, 1)
